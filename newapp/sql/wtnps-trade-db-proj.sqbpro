	id int not null,
	symbol varchar(20) not null,
	currency varchar(10) not null,
	price_variation int not null,
	type_variation varchar(20) not null,
	value_variation float not null,
	enable boolean not null default true,
	PRIMARY KEY (id)
)

insert into assets values (1, 'WDO$', 'R$', 0.5, 'tick', 5.00, true) 

CREATE TABLE &quot;WDO$_M5_202204271625_202511211825&quot; (
	&quot;&lt;DATE&gt;&quot;	TEXT,
	&quot;&lt;TIME&gt;&quot;	TEXT,
	&quot;&lt;OPEN&gt;&quot;	REAL,
	&quot;&lt;HIGH&gt;&quot;	REAL,
	&quot;&lt;LOW&gt;&quot;	REAL,
	&quot;&lt;CLOSE&gt;&quot;	REAL,
	&quot;&lt;TICKVOL&gt;&quot;	INTEGER,
	&quot;&lt;VOL&gt;&quot;	INTEGER,
	&quot;&lt;SPREAD&gt;&quot;	INTEGER
)

CREATE TABLE assets_rates (
	id INTEGER NOT NULL, 
	symbol VARCHAR(20) NOT NULL, 
	timestamp DATETIME NOT NULL, 
	timeframe int NOT NULL, 
	timeframe_str varchar(20),
	open float,
	high float,
	low float,
	close float,
	tick_volume INTEGER,
	volume INTEGER,
	spread INTEGER,
	support_level boolean, 
	resistance_level boolean, 
	ema_9 FLOAT, 
	sma_20 FLOAT, 
	sma_50 FLOAT, 
	sma_200 FLOAT,
	created_at DATETIME NOT NULL, 
	modify_at DATETIME,
	PRIMARY KEY (id),
	UNIQUE (symbol, timestamp, timeframe)
)
insert into assets_rates
select ROWID as id, 
	   'WDO$' as symbol,
	   replace(&quot;&lt;DATE&gt;&quot;,'.','-') || ' ' || &quot;&lt;TIME&gt;&quot; as timestamp,  
	   300 as timeframe,
	   'M5' as timeframe_str,
		cast(&quot;&lt;OPEN&gt;&quot; as float),
		cast(&quot;&lt;HIGH&gt;&quot;as float),
		cast(&quot;&lt;LOW&gt;&quot;as float),
		cast(&quot;&lt;CLOSE&gt;&quot;as float),
		&quot;&lt;TICKVOL&gt;&quot;,
		&quot;&lt;VOL&gt;&quot;,
		&quot;&lt;SPREAD&gt;&quot;,
		false,
		false,
		0,
		0,
		0,
		0,
		datetime('now'),
		null
  from WDO$_M5_202204271625_202511211825
order by 3 asc  
